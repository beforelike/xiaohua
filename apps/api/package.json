    "@types/supertest": "^6.0.3",
    "eslint": "^10.0.0",
    "globals": "^17.0.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "tsup": "^8.5.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.0.0"
