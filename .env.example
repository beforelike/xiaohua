HOST=127.0.0.1
PORT=8787
WEB_ORIGIN=http://127.0.0.1:5173,http://127.0.0.1:5174
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

COMMAND_PROVIDER=rules
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# 是否使用 LLM 增强提示词（true/false），需要配置 LLM 相关参数
LLM_ENHANCE_PROMPT=true

# 本地开发默认连接 Stable Diffusion WebUI；CI 会显式覆盖为 mock。
IMAGE_PROVIDER=stable-diffusion-webui
SD_WEBUI_BASE_URL=http://127.0.0.1:7860
SD_STEPS=28
SD_CFG_SCALE=7
SD_SAMPLER=DPM++ 2M Karras
SD_DENOISING_STRENGTH=0.7
# 全局画风提示词，会追加到每次生图的 prompt 前面
SD_STYLE_PROMPT=digital illustration, clean lineart, vibrant colors, anime style, high quality, detailed
ASSET_CACHE_DIR=.cache/assets

ASR_PROVIDER=mock
ASR_BASE_URL=http://127.0.0.1:9000
