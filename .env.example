HOST=127.0.0.1
PORT=8787
WEB_ORIGIN=http://127.0.0.1:5173,http://127.0.0.1:5174
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

COMMAND_PROVIDER=rules
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# 是否使用 LLM 增强提示词（true/false），需要配置 LLM 相关参数
LLM_ENHANCE_PROMPT=true

# Gemini 图片 API 为主路径，失败时自动回退到 Stable Diffusion WebUI。
IMAGE_PROVIDER=gemini-image
GEMINI_IMAGE_BASE_URL=http://127.0.0.1:8045/v1
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_VISION_MODEL=gemini-3-flash
GEMINI_IMAGE_API_KEY=
SD_WEBUI_BASE_URL=http://127.0.0.1:7860
SD_STEPS=28
SD_CFG_SCALE=7
SD_SAMPLER=DPM++ 2M Karras
SD_DENOISING_STRENGTH=0.7
# 全局画风提示词，会追加到每次生图的 prompt 前面
SD_STYLE_PROMPT=digital illustration, clean lineart, vibrant colors, anime style, high quality, detailed
ASSET_CACHE_DIR=.cache/assets
# Windows: python -m venv apps/api/.venv-image && apps/api/.venv-image/Scripts/python.exe -m pip install -r apps/api/image-processing-requirements.txt
IMAGE_PROCESSOR_PYTHON=.venv-image/Scripts/python.exe

ASR_PROVIDER=mock
ASR_BASE_URL=http://127.0.0.1:9000
