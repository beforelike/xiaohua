# FastAPI 后端
XIAOHUA_HOST=127.0.0.1
XIAOHUA_PORT=8000
XIAOHUA_DEBUG=false
XIAOHUA_PRESET=default

# 命令解析
XIAOHUA_COMMAND_PROVIDER=hybrid
XIAOHUA_COMMAND_CONFIDENCE_THRESHOLD=0.6
XIAOHUA_LLM_BASE_URL=
XIAOHUA_LLM_MODEL=
XIAOHUA_LLM_API_KEY=
XIAOHUA_LLM_TIMEOUT_SECONDS=20
XIAOHUA_LLM_TEMPERATURE=0.2

# 图片生成：直接调用本机 Fooocus，不经过任何云端图片 API
XIAOHUA_IMAGE_PROVIDER=fooocus
XIAOHUA_FOOOCUS_PATH=C:\Users\woo_w\Downloads\Fooocus-main\Fooocus-main
# 必须指向安装了 CUDA PyTorch 和 Fooocus requirements 的 Python 3.10 环境
XIAOHUA_FOOOCUS_PYTHON=python
XIAOHUA_FOOOCUS_TIMEOUT_SECONDS=600
XIAOHUA_DEFAULT_STEPS=28
XIAOHUA_DEFAULT_CFG_SCALE=7
XIAOHUA_DEFAULT_SAMPLER=DPM++ 2M Karras
XIAOHUA_ASSET_CACHE_DIR=.cache/assets

# 本地 ASR
XIAOHUA_ASR_PROVIDER=mock
XIAOHUA_ASR_ENDPOINT=http://127.0.0.1:9000
