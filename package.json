{
  "name": "xiaohua",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,yellow \"npm run dev --workspace @xiaohua/web\" \"npm run dev:api\"",
    "dev:api": "cd apps/api-py && python -m src.main",
    "test:python": "cd apps/api-py && python -m pytest -q",
    "lint:python": "cd apps/api-py && python -m ruff check src tests",
    "format:python": "cd apps/api-py && python -m ruff format src tests",
    "format:python:check": "cd apps/api-py && python -m ruff format --check src tests",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@vitest/coverage-v8": "^3.2.4",
    "concurrently": "^9.2.1",
    "prettier": "^3.6.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
